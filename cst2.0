-- ═══════════════════════════════════════════════════════════
--  kirmic.dev  ·  Clean ESP & Single Billboard Stack v10.0
--  Removed RGB Sliders  ·  Clean Overhead Floating Name+Dist Stack
-- ═══════════════════════════════════════════════════════════

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

while not LocalPlayer do task.wait(); LocalPlayer = Players.LocalPlayer end
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = Workspace.CurrentCamera
while not Camera do task.wait(); Camera = Workspace.CurrentCamera end

-- ─── THEME ───────────────────────────────────────────────
local T = {
    Bg       = Color3.fromRGB(12, 12, 16),
    CardBg   = Color3.fromRGB(18, 18, 24),
    CardBord = Color3.fromRGB(38, 36, 52),
    TabLine  = Color3.fromRGB(28, 28, 38),
    White    = Color3.fromRGB(240, 242, 250),
    Gray     = Color3.fromRGB(150, 153, 168),
    Muted    = Color3.fromRGB(85, 88, 102),
    Dim      = Color3.fromRGB(45, 45, 58),
    Accent   = Color3.fromRGB(128, 118, 225),
    AccentGlow=Color3.fromRGB(150, 140, 245),
    TogOn    = Color3.fromRGB(128, 118, 225),
    TogOff   = Color3.fromRGB(26, 26, 36),
    TogBord  = Color3.fromRGB(48, 46, 64),
    SlFill   = Color3.fromRGB(128, 118, 225),
    SlTrack  = Color3.fromRGB(30, 30, 42),
    StatusGr = Color3.fromRGB(70, 200, 100),
}
local FNT  = Enum.Font.GothamMedium
local FNTB = Enum.Font.GothamBold
local FNTS = Enum.Font.Gotham
local twF  = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ─── CLEANUP ─────────────────────────────────────────────
for _,n in ipairs({"kirmic_loader","kirmic_v10"}) do local g=PlayerGui:FindFirstChild(n) if g then g:Destroy() end end
if CoreGui:FindFirstChild("CTS_Visuals") then CoreGui.CTS_Visuals:Destroy() end

-- ─── STATE ───────────────────────────────────────────────
local S = {
    mPen=500,mVel=1000,mGrav=10,sPen=300,sVel=800,sGrav=10,
    
    -- Enemy ESP (Bright Red Theme)
    eHull=false,eHullFill=5,eHullOut=0,eHullR=255,eHullG=50,eHullB=50,
    eTurret=false,
    eModule=false,eModFill=6,eModOut=0,eModR=255,eModG=200,eModB=50,
    eEngine=false,eAmmo=false,eTrans=false,eDriver=false,
    eDist=false,eDistH=0,
    eName=false,eNameH=0,
    
    -- Team ESP (Bright Blue Theme)
    tHull=false,tHullFill=5,tHullOut=0,tHullR=50,tHullG=150,tHullB=255,
    tTurret=false,
    tModule=false,tModFill=6,tModOut=0,tModR=255,tModG=200,tModB=50,
    tEngine=false,tAmmo=false,tTrans=false,tDriver=false,
    tDist=false,tDistH=0,
    tName=false,tNameH=0,
    
    aimEnable=false,aimSilent=false,aimFov=120,aimHitbox="Head",
    noRecoil=false,noSpread=false,rapidFire=false,
    toggleKey="RightShift",
}

-- ─── HELPERS ─────────────────────────────────────────────
local function make(c,p)
    local o=Instance.new(c)
    for k,v in pairs(p) do if k~="Parent" then o[k]=v end end
    if p.Parent then o.Parent=p.Parent end; return o
end
local function stk(pr,col,th) return make("UIStroke",{Color=col or T.CardBord,Thickness=th or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=pr}) end

local initMainGui

-- ═══════════════════════════════════════════════════════════
--  LOADER
-- ═══════════════════════════════════════════════════════════
local loaderGui = make("ScreenGui",{Name="kirmic_loader",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=1000,Parent=PlayerGui})
local lWin = make("Frame",{Size=UDim2.fromOffset(280,160),Position=UDim2.new(0.5,0,0.5,0),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=T.Bg,BorderSizePixel=0,Active=true,Draggable=true,Parent=loaderGui})
stk(lWin,T.CardBord,1)

make("TextLabel",{Size=UDim2.new(1,0,0,20),Position=UDim2.fromOffset(0,16),BackgroundTransparency=1,Text="kirmic.dev",TextColor3=T.White,TextSize=16,Font=FNTB,Parent=lWin})
make("TextLabel",{Size=UDim2.new(1,0,0,12),Position=UDim2.fromOffset(0,38),BackgroundTransparency=1,Text="v10.0 Overhead Stack",TextColor3=T.Muted,TextSize=10,Font=FNT,Parent=lWin})
local sLbl=make("TextLabel",{Size=UDim2.new(1,0,0,12),Position=UDim2.fromOffset(0,62),BackgroundTransparency=1,Text="Ready to inject",TextColor3=T.Muted,TextSize=9,Font=FNT,Parent=lWin})
local pTrk=make("Frame",{Size=UDim2.new(1,-40,0,3),Position=UDim2.new(0,20,0,82),BackgroundColor3=T.SlTrack,BorderSizePixel=0,Visible=false,Parent=lWin})
local pFill=make("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=pTrk})
local pLbl=make("TextLabel",{Size=UDim2.new(1,0,0,10),Position=UDim2.fromOffset(0,90),BackgroundTransparency=1,Text="0%",TextColor3=T.White,TextSize=8,Font=FNTB,Visible=false,Parent=lWin})
local iBtn=make("TextButton",{Size=UDim2.new(1,-40,0,30),Position=UDim2.new(0,20,0,110),BackgroundColor3=T.CardBg,BorderSizePixel=0,Text="INJECT ENGINE",TextColor3=T.White,TextSize=10,Font=FNTB,AutoButtonColor=false,Parent=lWin})
stk(iBtn,T.CardBord,1)
iBtn.MouseEnter:Connect(function() TweenService:Create(iBtn,twF,{BackgroundColor3=T.Dim}):Play() end)
iBtn.MouseLeave:Connect(function() TweenService:Create(iBtn,twF,{BackgroundColor3=T.CardBg}):Play() end)

local injecting=false
iBtn.MouseButton1Click:Connect(function()
    if injecting then return end; injecting=true
    iBtn.Visible=false; pTrk.Visible=true; pLbl.Visible=true; sLbl.Text="Injecting..."; sLbl.TextColor3=T.White
    TweenService:Create(pFill,TweenInfo.new(1.4,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size=UDim2.new(1,0,1,0)}):Play()
    task.spawn(function() for i=1,100 do pLbl.Text=i.."%" task.wait(0.012) end end)
    task.delay(0.6,function() sLbl.Text="Binding vehicle scanner..." end)
    task.delay(1.1,function() sLbl.Text="Active!" end)
    task.delay(1.4,function()
        TweenService:Create(lWin,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
        task.wait(0.25); loaderGui:Destroy(); task.wait(0.15); initMainGui()
    end)
end)

-- ═══════════════════════════════════════════════════════════
--  REAL GAME ENGINE (SINGLE OVERHEAD BILLBOARD STACK)
-- ═══════════════════════════════════════════════════════════
local function startGameEngine()
    local ESP=Instance.new("Folder"); ESP.Name="CTS_Visuals"; ESP.Parent=CoreGui
    local EI={}; local myPx="Chassis"..LocalPlayer.Name

    local function IsMe(c)
        if not c then return true end
        if c.Name == myPx or c.Name:find(LocalPlayer.Name) then return true end
        if LocalPlayer.Character and c:IsAncestorOf(LocalPlayer.Character) then return true end
        return false
    end

    local function IsTeam(c)
        local rawName = c.Name:gsub("^Chassis", "")
        local p = Players:FindFirstChild(rawName)
        if p and p.Team and LocalPlayer.Team then return p.Team == LocalPlayer.Team end
        return false
    end

    local function InitGun()
        local v=Workspace:FindFirstChild("Vehicles") or Workspace
        local mc=v:FindFirstChild(myPx) or Workspace:FindFirstChild(myPx); if not mc then return end

        for _, d in ipairs(mc:GetDescendants()) do
            if d.Name == "Shells" then
                for _, sh in ipairs(d:GetChildren()) do
                    local p = sh:FindFirstChild("Penetration") or sh:FindFirstChild("ArmorPenetration")
                    local v2 = sh:FindFirstChild("ShellSpeed") or sh:FindFirstChild("Velocity") or sh:FindFirstChild("MuzzleVelocity")
                    local g = sh:FindFirstChild("BulletGravity") or sh:FindFirstChild("Gravity")
                    if p and p:IsA("ValueBase") then S.mPen = math.floor(p.Value) end
                    if v2 and v2:IsA("ValueBase") then S.mVel = math.floor(v2.Value) end
                    if g and g:IsA("ValueBase") then S.mGrav = math.floor(g.Value) end
                    break
                end
                break
            end
        end

        local sec = mc:FindFirstChild("Secondary", true)
        if sec then
            for _, d in ipairs(sec:GetDescendants()) do
                if d.Name == "Shells" then
                    for _, sh in ipairs(d:GetChildren()) do
                        local p = sh:FindFirstChild("Penetration") or sh:FindFirstChild("ArmorPenetration")
                        local v2 = sh:FindFirstChild("ShellSpeed") or sh:FindFirstChild("Velocity") or sh:FindFirstChild("MuzzleVelocity")
                        local g = sh:FindFirstChild("BulletGravity") or sh:FindFirstChild("Gravity")
                        if p and p:IsA("ValueBase") then S.sPen = math.floor(p.Value) end
                        if v2 and v2:IsA("ValueBase") then S.sVel = math.floor(v2.Value) end
                        if g and g:IsA("ValueBase") then S.sGrav = math.floor(g.Value) end
                        break
                    end
                    break
                end
            end
        end
    end
    pcall(InitGun)

    local function UpdGun()
        local v=Workspace:FindFirstChild("Vehicles") or Workspace
        local mc=v:FindFirstChild(myPx) or Workspace:FindFirstChild(myPx); if not mc then return end

        for _, d in ipairs(mc:GetDescendants()) do
            if d.Name == "Shells" then
                for _, sh in ipairs(d:GetChildren()) do
                    local p = sh:FindFirstChild("Penetration") or sh:FindFirstChild("ArmorPenetration")
                    local v2 = sh:FindFirstChild("ShellSpeed") or sh:FindFirstChild("Velocity") or sh:FindFirstChild("MuzzleVelocity")
                    local g = sh:FindFirstChild("BulletGravity") or sh:FindFirstChild("Gravity")
                    if p and p:IsA("ValueBase") then p.Value = S.mPen end
                    if v2 and v2:IsA("ValueBase") then v2.Value = S.mVel end
                    if g and g:IsA("ValueBase") then g.Value = S.mGrav end
                end
            end
        end

        local sec = mc:FindFirstChild("Secondary", true)
        if sec then
            for _, d in ipairs(sec:GetDescendants()) do
                if d.Name == "Shells" then
                    for _, sh in ipairs(d:GetChildren()) do
                        local p = sh:FindFirstChild("Penetration") or sh:FindFirstChild("ArmorPenetration")
                        local v2 = sh:FindFirstChild("ShellSpeed") or sh:FindFirstChild("Velocity") or sh:FindFirstChild("MuzzleVelocity")
                        local g = sh:FindFirstChild("BulletGravity") or sh:FindFirstChild("Gravity")
                        if p and p:IsA("ValueBase") then p.Value = S.sPen end
                        if v2 and v2:IsA("ValueBase") then v2.Value = S.sVel end
                        if g and g:IsA("ValueBase") then g.Value = S.sGrav end
                    end
                end
            end
        end
    end
    task.spawn(function() while true do task.wait(1.5); pcall(UpdGun) end end)

    local function MkHL(part,name)
        local h=Instance.new("Highlight"); h.Name=name; h.Adornee=part; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=ESP; return h
    end

    -- Single Clean Billboard Stack (Name on Top, Distance Below) floating HIGH above tank!
    local function MkOverheadBillboard(targetModel)
        local b = Instance.new("BillboardGui")
        b.Name = "Overhead_ESP"
        b.Adornee = targetModel
        b.Size = UDim2.new(0, 200, 0, 45)
        b.StudsOffset = Vector3.new(0, 8, 0)
        b.AlwaysOnTop = true
        b.Parent = ESP

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, 0, 1, 0)
        container.BackgroundTransparency = 1
        container.Parent = b

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 2)
        layout.Parent = container

        -- Name Tag (Top)
        local nLbl = Instance.new("TextLabel")
        nLbl.Size = UDim2.new(1, 0, 0, 18)
        nLbl.BackgroundTransparency = 1
        nLbl.Font = FNTB
        nLbl.TextSize = 13
        nLbl.TextColor3 = T.White
        nLbl.TextStrokeTransparency = 0.3
        nLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        nLbl.LayoutOrder = 1
        nLbl.Parent = container

        -- Distance Tag (Bottom)
        local dLbl = Instance.new("TextLabel")
        dLbl.Size = UDim2.new(1, 0, 0, 16)
        dLbl.BackgroundTransparency = 1
        dLbl.Font = FNTS
        dLbl.TextSize = 11
        dLbl.TextColor3 = Color3.fromRGB(220, 222, 235)
        dLbl.TextStrokeTransparency = 0.4
        dLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        dLbl.LayoutOrder = 2
        dLbl.Parent = container

        return b, nLbl, dLbl
    end

    local function Scan(chassis)
        if not chassis or EI[chassis] or IsMe(chassis) then return end
        local data={Chassis=chassis,Highlights={},Billboard=nil}

        -- Hull & Turret Highlights
        local hull=chassis:FindFirstChild("Hull") or chassis:FindFirstChild("Bounding Box") or chassis
        local hullAdornee = (hull:IsA("Model") or hull:IsA("BasePart")) and hull or chassis
        data.Highlights.Hull = MkHL(hullAdornee, "H_ESP")

        local turret=chassis:FindFirstChild("Turret")
        local turretAdornee = turret and ((turret:IsA("Model") or turret:IsA("BasePart")) and turret or chassis) or chassis
        data.Highlights.Turret = MkHL(turretAdornee, "T_ESP")

        -- Overhead Billboard attached directly to main chassis Model
        local bGui, nLbl, dLbl = MkOverheadBillboard(chassis)
        data.Billboard = bGui
        data.NameLbl = nLbl
        data.DistLbl = dLbl

        -- Module Highlights
        local mods={}
        for _,desc in ipairs(chassis:GetDescendants()) do
            if desc:IsA("BasePart") or desc:IsA("Model") then
                local n=desc.Name:lower(); local cat=nil
                if n:find("engine") or n:find("motor") or n:find("radiator") then cat="Engine"
                elseif n=="ammunition" or n:find("ammo") or n:find("fuel") then cat="Ammo"
                elseif n:find("trans") or n:find("transmission") or n:find("gearbox") then cat="Transmission"
                elseif n:find("driver") or n:find("commander") or n:find("gunner") or n:find("loader") or n:find("crew") then cat="Driver" end
                if cat then table.insert(mods,{Object=desc,Category=cat,Highlight=MkHL(desc,"M_"..cat)}) end
            end
        end
        data.Modules=mods; EI[chassis]=data
    end

    RunService.RenderStepped:Connect(function()
        local container = Workspace:FindFirstChild("Vehicles") or Workspace
        for _, c in ipairs(container:GetChildren()) do
            if c:IsA("Model") and c ~= LocalPlayer.Character and (c.Name:find("^Chassis") or c:FindFirstChild("Hull") or c:FindFirstChild("Turret") or c:FindFirstChild("Engine")) then
                Scan(c)
            end
        end

        local camPos=Camera.CFrame.Position
        for chassis,data in pairs(EI) do
            if not chassis or not chassis.Parent then
                for _,h in pairs(data.Highlights) do h:Destroy() end
                if data.Billboard then data.Billboard:Destroy() end
                for _,m in ipairs(data.Modules) do m.Highlight:Destroy() end
                EI[chassis]=nil
            else
                local isTeam=IsTeam(chassis); local px=isTeam and "t" or "e"
                
                -- Hull Highlight
                local hH=data.Highlights.Hull
                if hH then 
                    hH.Enabled=S[px.."Hull"]
                    if S[px.."Hull"] then 
                        local c=Color3.fromRGB(S[px.."HullR"],S[px.."HullG"],S[px.."HullB"])
                        hH.FillColor=c; hH.OutlineColor=c
                        hH.FillTransparency=1-(S[px.."HullFill"]/10)
                        hH.OutlineTransparency=1-(S[px.."HullOut"]/10) 
                    end 
                end
                
                -- Turret Highlight
                local hT=data.Highlights.Turret
                if hT then 
                    hT.Enabled=S[px.."Turret"]
                    if S[px.."Turret"] then 
                        local c=Color3.fromRGB(S[px.."HullR"],S[px.."HullG"],S[px.."HullB"])
                        hT.FillColor=c; hT.OutlineColor=c
                        hT.FillTransparency=1-(S[px.."HullFill"]/10)
                        hT.OutlineTransparency=1-(S[px.."HullOut"]/10) 
                    end 
                end

                -- Module Highlights
                local mE=S[px.."Module"]
                for _,m in ipairs(data.Modules) do
                    local sub=false
                    if mE then
                        if m.Category=="Engine" and S[px.."Engine"] then sub=true
                        elseif m.Category=="Ammo" and S[px.."Ammo"] then sub=true
                        elseif m.Category=="Transmission" and S[px.."Trans"] then sub=true
                        elseif m.Category=="Driver" and S[px.."Driver"] then sub=true end
                    end
                    m.Highlight.Enabled=sub
                    if sub then local c=Color3.fromRGB(S[px.."ModR"],S[px.."ModG"],S[px.."ModB"]); m.Highlight.FillColor=c; m.Highlight.OutlineColor=T.White; m.Highlight.FillTransparency=1-(S[px.."ModFill"]/10); m.Highlight.OutlineTransparency=1-(S[px.."ModOut"]/10) end
                end
                
                -- Single Overhead Billboard positioning (Cleanly stacked above tank!)
                local showName = S[px.."Name"]
                local showDist = S[px.."Dist"]
                local bGui = data.Billboard

                if bGui then
                    bGui.Enabled = showName or showDist
                    if showName or showDist then
                        local hOffset = 8 + (showName and S[px.."NameH"] or S[px.."DistH"])
                        bGui.StudsOffset = Vector3.new(0, hOffset, 0)

                        local pivot = chassis:GetPivot().Position
                        local dist = math.floor((pivot - camPos).Magnitude / 3)

                        local rawN = chassis.Name:gsub("^Chassis","")
                        local tp = Players:FindFirstChild(rawN)

                        data.NameLbl.Visible = showName
                        if showName then
                            data.NameLbl.Text = tp and tp.DisplayName or rawN
                            data.NameLbl.TextColor3 = Color3.fromRGB(S[px.."HullR"], S[px.."HullG"], S[px.."HullB"])
                        end

                        data.DistLbl.Visible = showDist
                        if showDist then
                            data.DistLbl.Text = "[" .. dist .. " m]"
                        end
                    end
                end
            end
        end
    end)

    return UpdGun
end

-- ═══════════════════════════════════════════════════════════
--  MAIN GUI  ·  MOBILE & PC COMPATIBLE
-- ═══════════════════════════════════════════════════════════
initMainGui = function()
    local triggerUpdGun = startGameEngine()

    local gui = make("ScreenGui",{Name="kirmic_v10",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=999,Parent=PlayerGui})

    local W = 540; local H = 420
    local win = make("Frame",{Name="W",Size=UDim2.fromOffset(W,H),Position=UDim2.new(0.5,0,0.5,0),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=T.Bg,BorderSizePixel=0,Active=true,Parent=gui})
    stk(win,T.CardBord,1)

    local function rescale()
        local vp=Camera.ViewportSize; local sf=1
        if vp.X<580 or vp.Y<460 then sf=math.clamp(math.min(vp.X/580,vp.Y/460),0.4,0.95) end
        local s=win:FindFirstChild("_S"); if not s then s=Instance.new("UIScale"); s.Name="_S"; s.Parent=win end; s.Scale=sf
    end
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale); rescale()

    -- Mobile & PC Dragging Engine
    local dragging,dragStart,dragWinStart=false,nil,nil
    local function startDrag(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=i.Position; dragWinStart=win.Position
        end
    end
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d=i.Position-dragStart; local sc=win:FindFirstChild("_S") and win._S.Scale or 1
            win.Position=UDim2.new(dragWinStart.X.Scale,dragWinStart.X.Offset+(d.X/sc),dragWinStart.Y.Scale,dragWinStart.Y.Offset+(d.Y/sc))
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)

    -- ─── TAB BAR ─────────────────────────────────────────
    local tabH = 38
    local tabBar = make("Frame",{Size=UDim2.new(1,0,0,tabH),BackgroundColor3=T.Bg,BorderSizePixel=0,Active=true,Parent=win})
    tabBar.InputBegan:Connect(startDrag)

    make("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),BackgroundColor3=T.TabLine,BorderSizePixel=0,Parent=tabBar})

    local tabHolder = make("Frame",{Size=UDim2.new(1,0,1,-1),BackgroundTransparency=1,Parent=tabBar})
    make("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,HorizontalAlignment=Enum.HorizontalAlignment.Center,VerticalAlignment=Enum.VerticalAlignment.Center,Padding=UDim.new(0,0),Parent=tabHolder})

    local TAB_NAMES = {"Gun Mods", "Visuals", "Aimbot", "Settings"}
    local tabBtns,tabPages,tabLines,curTab = {},{},{},nil

    local contentHost = make("Frame",{Size=UDim2.new(1,0,1,-tabH-22),Position=UDim2.fromOffset(0,tabH),BackgroundTransparency=1,ClipsDescendants=true,Parent=win})

    local function goTab(name)
        if curTab==name then return end
        if curTab then
            tabPages[curTab].Visible=false
            TweenService:Create(tabBtns[curTab],twF,{TextColor3=T.Muted}):Play()
            TweenService:Create(tabLines[curTab],twF,{BackgroundTransparency=1}):Play()
        end
        curTab=name; tabPages[name].Visible=true
        TweenService:Create(tabBtns[name],twF,{TextColor3=T.White}):Play()
        TweenService:Create(tabLines[name],twF,{BackgroundTransparency=0}):Play()
    end

    for i,name in ipairs(TAB_NAMES) do
        local btn = make("TextButton",{Size=UDim2.new(1/#TAB_NAMES,0,1,0),BackgroundTransparency=1,Text=name,TextColor3=T.Muted,TextSize=12,Font=FNTB,AutoButtonColor=false,LayoutOrder=i,BorderSizePixel=0,Parent=tabHolder})
        local ul = make("Frame",{Size=UDim2.new(0,36,0,2),AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-1),BackgroundColor3=T.Accent,BorderSizePixel=0,BackgroundTransparency=1,Parent=btn})

        local pg = make("Frame",{Name=name,Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Visible=false,Parent=contentHost})
        tabBtns[name]=btn; tabPages[name]=pg; tabLines[name]=ul

        btn.MouseEnter:Connect(function() if curTab~=name then TweenService:Create(btn,twF,{TextColor3=T.Gray}):Play() end end)
        btn.MouseLeave:Connect(function() if curTab~=name then TweenService:Create(btn,twF,{TextColor3=T.Muted}):Play() end end)
        btn.MouseButton1Click:Connect(function() goTab(name) end)
    end

    -- ─── STATUS BAR ──────────────────────────────────────
    local sBar = make("Frame",{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,1,-22),BackgroundColor3=T.Bg,BorderSizePixel=0,Parent=win})
    make("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=T.TabLine,BorderSizePixel=0,Parent=sBar})
    local dot = make("Frame",{Size=UDim2.fromOffset(5,5),Position=UDim2.fromOffset(12,9),BackgroundColor3=T.StatusGr,BorderSizePixel=0,Parent=sBar})
    make("TextLabel",{Size=UDim2.fromOffset(100,22),Position=UDim2.fromOffset(22,0),BackgroundTransparency=1,Text="UNDETECTED",TextColor3=T.StatusGr,TextSize=8,Font=FNTB,TextXAlignment=Enum.TextXAlignment.Left,Parent=sBar})
    local sInfo=make("TextLabel",{Size=UDim2.new(0.5,0,1,0),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-12,0,0),BackgroundTransparency=1,Text="",TextColor3=T.Muted,TextSize=8,Font=FNT,TextXAlignment=Enum.TextXAlignment.Right,Parent=sBar})

    local fpsVal,fpsCount,fpsLast=60,0,tick()
    local function getPing() local ok,v=pcall(function() return math.floor(LocalPlayer:GetNetworkPing()*1000) end); return ok and v or 0 end
    RunService.Heartbeat:Connect(function()
        fpsCount+=1; local now=tick()
        if now-fpsLast>=1 then fpsVal=fpsCount; fpsCount=0; fpsLast=now; sInfo.Text="Ping: "..getPing().."ms  FPS: "..fpsVal.."  RSHIFT to hide" end
    end)

    -- ═══════════════════════════════════════════════════════
    --  MOBILE-FRIENDLY COMPONENT BUILDERS
    -- ═══════════════════════════════════════════════════════

    local function mkColumnCard(parent, title, x, y, w, h)
        local card = make("Frame",{Size=UDim2.new(0,w,0,h),Position=UDim2.fromOffset(x,y),BackgroundColor3=T.CardBg,BorderSizePixel=0,Parent=parent})
        stk(card,T.CardBord,1)

        local hd = make("Frame",{Size=UDim2.new(1,0,0,28),Position=UDim2.fromOffset(0,0),BackgroundTransparency=1,Parent=card})
        make("TextLabel",{Size=UDim2.new(1,0,1,-4),Position=UDim2.fromOffset(0,2),BackgroundTransparency=1,Text=title,TextColor3=T.White,TextSize=11,Font=FNTB,TextXAlignment=Enum.TextXAlignment.Center,Parent=hd})
        local uLine = make("Frame",{Size=UDim2.new(0,34,0,2),AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-1),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=hd})

        local scroller = make("ScrollingFrame",{Size=UDim2.new(1,0,1,-28),Position=UDim2.fromOffset(0,28),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=0,ScrollBarImageTransparency=1,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(0,0,0,0),Active=true,Parent=card})
        local holder = make("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=scroller})
        make("UIPadding",{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),PaddingTop=UDim.new(0,8),PaddingBottom=UDim.new(0,12),Parent=holder})
        make("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,5),Parent=holder})

        return holder
    end

    local function mkToggle(parent, label, key, order)
        local row = make("Frame",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
        make("TextLabel",{Size=UDim2.new(1,-24,1,0),BackgroundTransparency=1,Text=label,TextColor3=T.Gray,TextSize=10,Font=FNTS,TextXAlignment=Enum.TextXAlignment.Left,Parent=row})

        local box = make("TextButton",{Size=UDim2.fromOffset(15,15),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),BackgroundColor3=S[key] and T.TogOn or T.TogOff,BorderSizePixel=0,Text="",AutoButtonColor=false,Parent=row})
        stk(box,S[key] and T.Accent or T.TogBord,1)
        local boxStk = box:FindFirstChildOfClass("UIStroke")

        local function doToggle()
            S[key]=not S[key]; local on=S[key]
            if on then
                if key == "eEngine" or key == "eAmmo" or key == "eTrans" or key == "eDriver" then S["eModule"] = true
                elseif key == "tEngine" or key == "tAmmo" or key == "tTrans" or key == "tDriver" then S["tModule"] = true end
            end
            TweenService:Create(box,TweenInfo.new(0.1),{BackgroundColor3=on and T.TogOn or T.TogOff}):Play()
            TweenService:Create(boxStk,TweenInfo.new(0.1),{Color=on and T.Accent or T.TogBord}):Play()
        end

        box.MouseButton1Click:Connect(doToggle)
        return box
    end

    local function mkSlider(parent, label, minV, maxV, key, suffix, order)
        suffix = suffix or ""
        local row = make("Frame",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
        make("TextLabel",{Size=UDim2.new(0.6,0,0,12),Position=UDim2.fromOffset(0,0),BackgroundTransparency=1,Text=label,TextColor3=T.Gray,TextSize=10,Font=FNTS,TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
        local valLbl=make("TextLabel",{Size=UDim2.new(0.4,0,0,12),Position=UDim2.new(0.6,0,0,0),BackgroundTransparency=1,Text=tostring(math.floor(S[key]))..suffix,TextColor3=T.Muted,TextSize=10,Font=FNT,TextXAlignment=Enum.TextXAlignment.Right,Parent=row})

        local trackBtn=make("TextButton",{Size=UDim2.new(1,0,0,20),Position=UDim2.fromOffset(0,12),BackgroundTransparency=1,Text="",AutoButtonColor=false,Parent=row})
        local trackLine=make("Frame",{Size=UDim2.new(1,0,0,4),Position=UDim2.fromOffset(0,8),BackgroundColor3=T.SlTrack,BorderSizePixel=0,Parent=trackBtn})
        local initR=math.clamp((S[key]-minV)/(maxV-minV),0,1)
        local fill=make("Frame",{Size=UDim2.new(initR,0,1,0),BackgroundColor3=T.SlFill,BorderSizePixel=0,Parent=trackLine})
        local tS=12
        local thumb=make("Frame",{Size=UDim2.fromOffset(tS,tS),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(initR,0,0.5,0),BackgroundColor3=T.AccentGlow,BorderSizePixel=0,ZIndex=5,Parent=trackLine})

        local dg=false
        local function upd(inputPos)
            local rel = (inputPos.X - trackLine.AbsolutePosition.X) / trackLine.AbsoluteSize.X
            rel=math.clamp(rel,0,1); local raw=math.floor(minV+(maxV-minV)*rel); S[key]=raw
            fill.Size=UDim2.new(rel,0,1,0); thumb.Position=UDim2.new(rel,0,0.5,0); valLbl.Text=tostring(raw)..suffix
            pcall(triggerUpdGun)
        end

        trackBtn.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                dg=true; upd(i.Position)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dg and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                upd(i.Position)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                dg=false
            end
        end)
    end

    local function mkSectionHeader(parent, text, order)
        local f = make("Frame",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
        make("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text=text,TextColor3=T.AccentGlow,TextSize=9,Font=FNTB,TextXAlignment=Enum.TextXAlignment.Left,Parent=f})
    end

    -- ═══════════════════════════════════════════════════════
    --  TAB 1: GUN MODS
    -- ═══════════════════════════════════════════════════════
    local gunPage = tabPages["Gun Mods"]
    local pad = 10; local gap = 10
    local colW = math.floor((W - pad*2 - gap) / 2)
    local cardH = H - tabH - 22 - pad*2

    local cm1Holder = mkColumnCard(gunPage, "Main Gun", pad, pad, colW, cardH)
    mkSlider(cm1Holder, "Penetration", 1, 9999, "mPen", "mm", 1)
    mkSlider(cm1Holder, "Velocity",    1, 9999, "mVel", "m/s", 2)
    mkSlider(cm1Holder, "Gravity",     1, 9999, "mGrav", "", 3)

    local cm2Holder = mkColumnCard(gunPage, "Secondary Gun", pad+colW+gap, pad, colW, cardH)
    mkSlider(cm2Holder, "Penetration", 1, 9999, "sPen", "mm", 1)
    mkSlider(cm2Holder, "Velocity",    1, 9999, "sVel", "m/s", 2)
    mkSlider(cm2Holder, "Gravity",     1, 9999, "sGrav", "", 3)

    -- ═══════════════════════════════════════════════════════
    --  TAB 2: VISUALS (NO RGB SLIDERS, CLEAN OVERHEAD ESP)
    -- ═══════════════════════════════════════════════════════
    local visPage = tabPages["Visuals"]

    -- LEFT COLUMN: ENEMY ESP
    local eHolder = mkColumnCard(visPage, "Enemy ESP", pad, pad, colW, cardH)

    mkSectionHeader(eHolder, "Highlights", 1)
    mkToggle(eHolder, "Hull ESP",   "eHull", 2)
    mkToggle(eHolder, "Turret ESP", "eTurret", 3)
    mkToggle(eHolder, "Module ESP", "eModule", 4)

    mkSectionHeader(eHolder, "Modules", 5)
    mkToggle(eHolder, "Engine",       "eEngine", 6)
    mkToggle(eHolder, "Ammo",         "eAmmo", 7)
    mkToggle(eHolder, "Transmission", "eTrans", 8)
    mkToggle(eHolder, "Driver",       "eDriver", 9)

    mkSectionHeader(eHolder, "Labels & Info", 10)
    mkToggle(eHolder, "Name Tags", "eName", 11)
    mkToggle(eHolder, "Distance",  "eDist", 12)
    mkSlider(eHolder, "Name Height", -30, 30, "eNameH", "", 13)

    mkSectionHeader(eHolder, "Adjustments (Hull & Turret)", 14)
    mkSlider(eHolder, "Fill Transparency", 0, 10, "eHullFill", "", 15)
    mkSlider(eHolder, "Outline Transparency", 0, 10, "eHullOut", "", 16)

    -- RIGHT COLUMN: TEAMMATE ESP
    local tHolder = mkColumnCard(visPage, "Teammate ESP", pad+colW+gap, pad, colW, cardH)

    mkSectionHeader(tHolder, "Highlights", 1)
    mkToggle(tHolder, "Team Hull",   "tHull", 2)
    mkToggle(tHolder, "Team Turret", "tTurret", 3)
    mkToggle(tHolder, "Team Module", "tModule", 4)

    mkSectionHeader(tHolder, "Modules", 5)
    mkToggle(tHolder, "Engine",       "tEngine", 6)
    mkToggle(tHolder, "Ammo",         "tAmmo", 7)
    mkToggle(tHolder, "Transmission", "tTrans", 8)
    mkToggle(tHolder, "Driver",       "tDriver", 9)

    mkSectionHeader(tHolder, "Labels & Info", 10)
    mkToggle(tHolder, "Name Tags", "tName", 11)
    mkToggle(tHolder, "Distance",  "tDist", 12)

    mkSectionHeader(tHolder, "Adjustments (Hull & Turret)", 13)
    mkSlider(tHolder, "Fill Transparency", 0, 10, "tHullFill", "", 14)
    mkSlider(tHolder, "Outline Transparency", 0, 10, "tHullOut", "", 15)

    -- ═══════════════════════════════════════════════════════
    --  TAB 3: AIMBOT
    -- ═══════════════════════════════════════════════════════
    local aimPage = tabPages["Aimbot"]

    local aim1Holder = mkColumnCard(aimPage, "Silent Aim / Lock", pad, pad, colW, cardH)
    mkToggle(aim1Holder, "Enable Aimbot", "aimEnable", 1)
    mkToggle(aim1Holder, "Silent Aim",    "aimSilent", 2)
    mkSlider(aim1Holder, "FOV Radius", 10, 500, "aimFov", "px", 3)

    local aim2Holder = mkColumnCard(aimPage, "Weapon Config", pad+colW+gap, pad, colW, cardH)
    mkToggle(aim2Holder, "No Recoil", "noRecoil", 1)
    mkToggle(aim2Holder, "No Spread", "noSpread", 2)
    mkToggle(aim2Holder, "Rapid Fire", "rapidFire", 3)

    -- ═══════════════════════════════════════════════════════
    --  TAB 4: SETTINGS
    -- ═══════════════════════════════════════════════════════
    local setPage = tabPages["Settings"]

    local set1Holder = mkColumnCard(setPage, "Menu Keybinds", pad, pad, colW, cardH)
    make("TextLabel",{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,Text="Menu Key: RSHIFT / INSERT",TextColor3=T.White,TextSize=10,Font=FNTS,TextXAlignment=Enum.TextXAlignment.Left,Parent=set1Holder})

    local set2Holder = mkColumnCard(setPage, "Unload", pad+colW+gap, pad, colW, cardH)
    local unlBtn = make("TextButton",{Size=UDim2.new(1,0,0,28),BackgroundColor3=T.CardBg,BorderSizePixel=0,Text="UNLOAD GUI",TextColor3=Color3.fromRGB(220,70,70),TextSize=10,Font=FNTB,AutoButtonColor=false,Parent=set2Holder})
    stk(unlBtn,Color3.fromRGB(160,50,50),1)
    unlBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    -- ─── STARTUP ─────────────────────────────────────────
    goTab("Gun Mods")

    local visible=true
    UserInputService.InputBegan:Connect(function(inp,gpe)
        if gpe then return end
        if inp.KeyCode==Enum.KeyCode.RightShift or inp.KeyCode==Enum.KeyCode.Insert then
            visible=not visible; win.Visible=visible
        end
    end)
end
