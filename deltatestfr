    end)
end

-- Render Active Tab & Subtabs
local function RefreshSubTabs(topTabName)
    for _, child in ipairs(LeftSubTabHolder:GetChildren()) do child:Destroy() end
    for _, child in ipairs(RightSubTabHolder:GetChildren()) do child:Destroy() end
    ClearPanels()

    if topTabName == "Combat" then
        local btnAimbot = CreateSubTabButton("AIMBOT", LeftSubTabHolder, 1.0, 0.0, true, function()
            PopulateCombatAimbot()
        end)
        local btnSilent = CreateSubTabButton("SILENT AIM", RightSubTabHolder, 1.0, 0.0, true, function()
            PopulateCombatSilentAim()
        end)
        PopulateCombatAimbot()

    elseif topTabName == "Visuals" then
        local activeVisualSub = "ENEMY"

        local function updateVisualState()
            for _, child in ipairs(LeftSubTabHolder:GetChildren()) do child:Destroy() end
            for _, child in ipairs(RightSubTabHolder:GetChildren()) do child:Destroy() end

            CreateSubTabButton("ENEMY", LeftSubTabHolder, 0.5, 0.0, activeVisualSub == "ENEMY", function()
                activeVisualSub = "ENEMY"
                updateVisualState()
                PopulateVisualsEnemy()
            end)
            CreateSubTabButton("AI", LeftSubTabHolder, 0.5, 0.5, activeVisualSub == "AI", function()
                activeVisualSub = "AI"
                updateVisualState()
                PopulateVisualsAI()
            end)
            CreateSubTabButton("WORLD", RightSubTabHolder, 1.0, 0.0, activeVisualSub == "WORLD", function()
                activeVisualSub = "WORLD"
                updateVisualState()
                PopulateVisualsWorld()
            end)
        end

        updateVisualState()
        PopulateVisualsEnemy()

    elseif topTabName == "Misc" or topTabName == "Other" then
        ClearPanels()

    elseif topTabName == "Settings" then
        CreateSubTabButton("GENERAL", LeftSubTabHolder, 1.0, 0.0, true, function()
            PopulateSettings()
        end)
        PopulateSettings()
    end
end

