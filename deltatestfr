    -- Update Vertical Line Segments so the LAST subtab vertical line stops at center (50%) - Forms 'L' shape exactly like Picture 2!
    local function UpdateTreeLines()
        local count = #Category.SubTabs
        for i, sub in ipairs(Category.SubTabs) do
            if sub.VerticalBranch then
                if i == count then
                    sub.VerticalBranch.Size = UDim2.new(0, 1, 0.5, 0)
                else
                    sub.VerticalBranch.Size = UDim2.new(0, 1, 1, 5)
                end
            end
        end
    end

    -- STAGGERED CASCADING DROPDOWN ANIMATION (EXACT DIRECT CALCULATION FOR 100% VISIBILITY)
    local function AnimateDropdown()
        local count = #Category.SubTabs
        -- Each item is 26px + 5px spacing + 12px padding = 31px per item
        local targetHeight = (count * 31) + 6

        if Category.Expanded then
            Tween(SubHolder, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetHeight)
            })
            Tween(HeaderBtn, TweenInfo.new(0.15), {BorderColor3 = Theme.WhiteLine})

            for i, sub in ipairs(Category.SubTabs) do
                sub.SubTabItemFrame.Position = UDim2.new(0, 0, 0, -8)
                sub.SubBtn.BackgroundTransparency = 1
                sub.SubLabel.TextTransparency = 1
                if sub.ActiveIndicator and Library.ActiveSubTab == sub then
                    sub.ActiveIndicator.BackgroundTransparency = 1
                end
                if sub.VerticalBranch then sub.VerticalBranch.BackgroundTransparency = 1 end
                if sub.HorizontalBranch then sub.HorizontalBranch.BackgroundTransparency = 1 end

                task.delay((i - 1) * 0.06, function()
                    if Category.Expanded then
                        Tween(sub.SubTabItemFrame, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                            Position = UDim2.new(0, 0, 0, 0)
                        })
                        Tween(sub.SubBtn, TweenInfo.new(0.18), {
                            BackgroundTransparency = 0
                        })
                        Tween(sub.SubLabel, TweenInfo.new(0.18), {
                            TextTransparency = 0
                        })
                        if sub.ActiveIndicator and Library.ActiveSubTab == sub then
                            Tween(sub.ActiveIndicator, TweenInfo.new(0.18), {BackgroundTransparency = 0})
                        end
                        if sub.VerticalBranch then
                            Tween(sub.VerticalBranch, TweenInfo.new(0.18), {BackgroundTransparency = 0})
                        end
                        if sub.HorizontalBranch then
                            Tween(sub.HorizontalBranch, TweenInfo.new(0.18), {BackgroundTransparency = 0})
                        end
                    end
                end)
            end
        else
            for i, sub in ipairs(Category.SubTabs) do
                local reverseIndex = count - i
                task.delay(reverseIndex * 0.03, function()
                    if not Category.Expanded then
                        Tween(sub.SubTabItemFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                            Position = UDim2.new(0, 0, 0, -6)
                        })
                        Tween(sub.SubBtn, TweenInfo.new(0.1), {BackgroundTransparency = 1})
                        Tween(sub.SubLabel, TweenInfo.new(0.1), {TextTransparency = 1})
                        if sub.ActiveIndicator then
                            Tween(sub.ActiveIndicator, TweenInfo.new(0.1), {BackgroundTransparency = 1})
                        end
                        if sub.VerticalBranch then Tween(sub.VerticalBranch, TweenInfo.new(0.1), {BackgroundTransparency = 1}) end
                        if sub.HorizontalBranch then Tween(sub.HorizontalBranch, TweenInfo.new(0.1), {BackgroundTransparency = 1}) end
                    end
                end)
            end

            task.delay(count * 0.03 + 0.03, function()
                if not Category.Expanded then
                    Tween(SubHolder, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Size = UDim2.new(1, 0, 0, 0)
                    })
                    Tween(HeaderBtn, TweenInfo.new(0.15), {BorderColor3 = Theme.Border})
                end
            end)
        end
    end
    Category.AnimateDropdown = AnimateDropdown

    HeaderBtn.MouseButton1Click:Connect(function()
        if #Category.SubTabs > 0 then
            -- ACCORDION MODE: Close all other open categories when opening a new one!
            if not Category.Expanded then
                for _, otherCat in ipairs(Library.Categories) do
                    if otherCat ~= Category and otherCat.Expanded and not otherCat.IsBottom then
                        otherCat.Expanded = false
                        otherCat.AnimateDropdown()
                    end
                end
            end

            Category.Expanded = not Category.Expanded
            AnimateDropdown()
        elseif Category.DirectSubTab then
            Library:SelectSubTab(Category.DirectSubTab)
        end
    end)

    Category.CategoryWrapper = CategoryWrapper
    Category.SubHolder = SubHolder
    Category.SubListFrame = SubListFrame
    Category.UpdateTreeLines = UpdateTreeLines
    table.insert(Library.Categories, Category)

    -- Create SubTab under Category
    function Category:CreateSubTab(subTabName)
        local SubTab = {}
        SubTab.Name = subTabName
        SubTab.Category = Category

        -- Item Frame containing Vertical Trunk Segment + Horizontal Connector + Sub-Button
        local SubTabItemFrame = Instance.new("Frame")
        SubTabItemFrame.Name = "SubTabFrame_" .. subTabName
        SubTabItemFrame.Size = UDim2.new(1, 0, 0, 26) -- 26px Height
        SubTabItemFrame.BackgroundTransparency = 1
        SubTabItemFrame.ClipsDescendants = true
        SubTabItemFrame.Parent = isBottom and CategoryWrapper or SubListFrame
        SubTab.SubTabItemFrame = SubTabItemFrame

        if not isBottom then
            -- Vertical Trunk Segment for this item
            local VerticalBranch = Instance.new("Frame")
            VerticalBranch.Name = "VerticalBranch"
            VerticalBranch.Size = UDim2.new(0, 1, 1, 5)
            VerticalBranch.Position = UDim2.new(0, 12, 0, 0)
            VerticalBranch.BackgroundColor3 = Theme.WhiteLineMuted
            VerticalBranch.BorderSizePixel = 0
            VerticalBranch.ZIndex = 2
            VerticalBranch.Parent = SubTabItemFrame
            SubTab.VerticalBranch = VerticalBranch

            -- Horizontal Branch Line connecting from left vertical line to sub-button
            local HorizontalBranch = Instance.new("Frame")
            HorizontalBranch.Name = "HorizontalBranch"
            HorizontalBranch.Size = UDim2.new(0, 10, 0, 1)
            HorizontalBranch.Position = UDim2.new(0, 12, 0.5, 0)
            HorizontalBranch.BackgroundColor3 = Theme.WhiteLineMuted
            HorizontalBranch.BorderSizePixel = 0
            HorizontalBranch.ZIndex = 2
            HorizontalBranch.Parent = SubTabItemFrame
            SubTab.HorizontalBranch = HorizontalBranch
        end

        -- SubTab Button Frame
        local SubBtn = Instance.new("TextButton")
        SubBtn.Name = "SubBtn"
        SubBtn.Size = isBottom and UDim2.new(1, -2, 0, 28) or UDim2.new(1, -26, 1, -4)
        SubBtn.Position = isBottom and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 24, 0, 2)
        SubBtn.BackgroundColor3 = Theme.Sidebar
        SubBtn.BorderSizePixel = 1
        SubBtn.BorderColor3 = Theme.Border
        SubBtn.ClipsDescendants = true
        SubBtn.Text = ""
        SubBtn.AutoButtonColor = false
        SubBtn.Parent = SubTabItemFrame

        -- Left Active Indicator Bar inside SubBtn
        local ActiveIndicator = Instance.new("Frame")
        ActiveIndicator.Name = "ActiveIndicator"
        ActiveIndicator.Size = UDim2.new(0, 2, 1, 0)
        ActiveIndicator.Position = UDim2.new(0, 0, 0, 0)
        ActiveIndicator.BackgroundColor3 = Theme.WhiteLine
        ActiveIndicator.BorderSizePixel = 0
        ActiveIndicator.BackgroundTransparency = 1
        ActiveIndicator.Parent = SubBtn

        -- SubTab Text Label
        local SubLabel = Instance.new("TextLabel")
        SubLabel.Name = "SubLabel"
        SubLabel.Size = UDim2.new(1, -12, 1, 0)
        SubLabel.Position = UDim2.new(0, 10, 0, 0)
        SubLabel.BackgroundTransparency = 1
        SubLabel.Text = subTabName
        SubLabel.Font = Enum.Font.GothamMedium
        SubLabel.TextSize = 12
        SubLabel.TextColor3 = Theme.TextMuted
        SubLabel.TextXAlignment = Enum.TextXAlignment.Left
        SubLabel.Parent = SubBtn

        -- Content Page Frame
        local PageFrame = Instance.new("ScrollingFrame")
        PageFrame.Name = "Page_" .. categoryName .. "_" .. subTabName
        PageFrame.Size = UDim2.new(1, 0, 1, 0)
        PageFrame.BackgroundTransparency = 1
        PageFrame.BorderSizePixel = 0
        PageFrame.Visible = false
        PageFrame.ScrollBarThickness = 3
        PageFrame.ScrollBarImageColor3 = Theme.WhiteLine
        PageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        PageFrame.Parent = Library.PageContainer

        local PageList = Instance.new("UIListLayout")
        PageList.SortOrder = Enum.SortOrder.LayoutOrder
        PageList.Padding = UDim.new(0, 10)
        PageList.Parent = PageFrame

        local PagePadding = Instance.new("UIPadding")
        PagePadding.PaddingLeft = UDim.new(0, 20)
        PagePadding.PaddingRight = UDim.new(0, 20)
        PagePadding.PaddingTop = UDim.new(0, 15)
        PagePadding.PaddingBottom = UDim.new(0, 15)
        PagePadding.Parent = PageFrame

        PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            PageFrame.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
        end)

        SubBtn.MouseButton1Click:Connect(function()
            Library:SelectSubTab(SubTab)
        end)

        SubBtn.MouseEnter:Connect(function()
            if Library.ActiveSubTab ~= SubTab then
                Tween(SubBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover, BorderColor3 = Theme.Border})
                Tween(SubLabel, TweenInfo.new(0.15), {TextColor3 = Theme.TextMain})
            end
        end)

        SubBtn.MouseLeave:Connect(function()
            if Library.ActiveSubTab ~= SubTab then
                Tween(SubBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Sidebar, BorderColor3 = Theme.Border})
                Tween(SubLabel, TweenInfo.new(0.15), {TextColor3 = Theme.TextMuted})
            end
        end)

        SubTab.SubBtn = SubBtn
        SubTab.SubLabel = SubLabel
        SubTab.ActiveIndicator = ActiveIndicator
        SubTab.PageFrame = PageFrame

        table.insert(Category.SubTabs, SubTab)
        table.insert(Library.AllSubTabs, SubTab)

        if not isBottom then
            Category.UpdateTreeLines()
        end

        if not Library.ActiveSubTab then
            Library:SelectSubTab(SubTab)
        end

        return SubTab
    end

    function Category:GetDirectPage()
        if not Category.DirectSubTab then
            Category.DirectSubTab = Category:CreateSubTab(categoryName)
            HeaderBtn.Visible = false
        end
        return Category.DirectSubTab
    end

    return Category
end

-- Select Active SubTab
function WorldGUI:SelectSubTab(targetSubTab)
    self.ActiveSubTab = targetSubTab
    
    if targetSubTab.Category and targetSubTab.Category.Name ~= targetSubTab.Name then
        self.HeaderTitle.Text = targetSubTab.Category.Name .. "  /  " .. targetSubTab.Name
    else
        self.HeaderTitle.Text = targetSubTab.Name
    end

    for _, sub in ipairs(self.AllSubTabs) do
        if sub == targetSubTab then
            sub.PageFrame.Visible = true
            Tween(sub.SubBtn, TweenInfo.new(0.2), {
                BackgroundColor3 = Theme.Card,
                BorderColor3 = Theme.WhiteLine
            })
            Tween(sub.SubLabel, TweenInfo.new(0.2), {TextColor3 = Theme.TextMain})
            Tween(sub.ActiveIndicator, TweenInfo.new(0.2), {BackgroundTransparency = 0})
        else
            sub.PageFrame.Visible = false
            Tween(sub.SubBtn, TweenInfo.new(0.2), {
                BackgroundColor3 = Theme.Sidebar,
                BorderColor3 = Theme.Border
            })
            Tween(sub.SubLabel, TweenInfo.new(0.2), {TextColor3 = Theme.TextMuted})
            Tween(sub.ActiveIndicator, TweenInfo.new(0.2), {BackgroundTransparency = 1})
        end
    end
end

