-- Function to Unload Script Completely
local function UnloadScript()
    IsUnloaded = true

    -- Disconnect all RBXScriptConnections
    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    Connections = {}

    -- Clean up all ESP Drawings and Instances
    for player, _ in pairs(ESP_Cache) do
        RemoveESP(player)
    end
    ESP_Cache = {}

    -- Destroy UI
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() ToggleBtn:Destroy() end)

    print("[Kernel.cc] Unloaded Successfully!")
end

