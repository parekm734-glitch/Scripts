                local scaleY = (viewportSize.Y * 0.70) / 440
                targetScale = math.clamp(math.min(scaleX, scaleY), 0.52, 0.65)
            else
                local scaleX = (viewportSize.X * 0.88) / 680
                local scaleY = (viewportSize.Y * 0.88) / 440
                targetScale = math.clamp(math.min(scaleX, scaleY), 0.65, 1)
            end

            UIScale.Scale = targetScale
        end
