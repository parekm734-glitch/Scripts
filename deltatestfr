-- Create Stepper / Sub-option Selector
local function AddSelectorRow(parent, options, defaultIndex, callback)
    local row = Instance.new("Frame")
    row.Name = "SelectorRow"
    row.Size = UDim2.new(1, 0, 0, 20)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 120, 0, 18)
    container.Position = UDim2.new(0, 26, 0, 1)
    container.BackgroundColor3 = Colors.Background
    container.BorderColor3 = Colors.Border
    container.BorderSizePixel = 1
    container.Parent = row

    local currentIndex = defaultIndex or 1

    local leftArrow = Instance.new("TextButton")
    leftArrow.Size = UDim2.new(0, 18, 1, 0)
    leftArrow.Position = UDim2.new(0, 0, 0, 0)
    leftArrow.BackgroundTransparency = 1
    leftArrow.Text = "<"
    leftArrow.TextColor3 = Colors.TextDim
    leftArrow.Font = MainFont
    leftArrow.TextSize = 12
    leftArrow.Parent = container

    local rightArrow = Instance.new("TextButton")
    rightArrow.Size = UDim2.new(0, 18, 1, 0)
    rightArrow.Position = UDim2.new(1, -18, 0, 0)
    rightArrow.BackgroundTransparency = 1
    rightArrow.Text = ">"
    rightArrow.TextColor3 = Colors.TextDim
    rightArrow.Font = MainFont
    rightArrow.TextSize = 12
    rightArrow.Parent = container

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(1, -36, 1, 0)
    valueLbl.Position = UDim2.new(0, 18, 0, 0)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = options[currentIndex] or ""
    valueLbl.TextColor3 = Colors.TextWhite
    valueLbl.Font = MainFont
    valueLbl.TextSize = 11
    valueLbl.Parent = container

    local function updateSelector()
        valueLbl.Text = options[currentIndex]
        if callback then callback(options[currentIndex], currentIndex) end
    end

    leftArrow.MouseButton1Click:Connect(function()
        currentIndex = currentIndex - 1
        if currentIndex < 1 then currentIndex = #options end
        updateSelector()
    end)

    rightArrow.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        updateSelector()
    end)

    return row
end

