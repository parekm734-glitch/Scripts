-- Hide All Drawing Elements Safely
local function HideAllStorageDrawings(storage)
    if not storage then return end
    if storage.Box then storage.Box.Visible = false end
    if storage.BoxOutline then storage.BoxOutline.Visible = false end
    if storage.HpBg then storage.HpBg.Visible = false end
    if storage.HpFill then storage.HpFill.Visible = false end
    if storage.DistTxt then storage.DistTxt.Visible = false end
    if storage.SkeletonLines then
        for _, l in ipairs(storage.SkeletonLines) do
            l.Visible = false
        end
    end
    if storage.Highlight then storage.Highlight.Enabled = false end
end

local function RemoveESP(player)
    if ESP_Cache[player] then
        local storage = ESP_Cache[player]
        HideAllStorageDrawings(storage)

        for _, obj in pairs(storage) do
            if typeof(obj) == "Instance" then
                pcall(function() obj:Destroy() end)
            elseif type(obj) == "table" then
                if obj.Remove then
                    pcall(function() obj:Remove() end)
                elseif #obj > 0 then
                    for _, subObj in ipairs(obj) do
                        if type(subObj) == "table" and subObj.Remove then
                            pcall(function() subObj:Remove() end)
                        end
                    end
                end
            end
        end
        ESP_Cache[player] = nil
    end
end

-- Drawing API or Fallback Instance Creation
local HasDrawing = (Drawing ~= nil and Drawing.new ~= nil)

local function CreateESPForPlayer(player)
    if IsUnloaded or player == LocalPlayer then return end
    RemoveESP(player)

    local storage = {}

    if HasDrawing then
        -- Box Outer Shadow (Black)
        local boxOutline = Drawing.new("Square")
        boxOutline.Thickness = 3
        boxOutline.Filled = false
        boxOutline.Color = Color3.fromRGB(0, 0, 0)
        boxOutline.Visible = false
        storage.BoxOutline = boxOutline

        -- 2D Box (White Default)
        local box = Drawing.new("Square")
        box.Thickness = 1
        box.Filled = false
        box.Color = ESP_State.BoxColor
        box.Visible = false
        storage.Box = box

        -- HP Bar Background
        local hpBg = Drawing.new("Square")
        hpBg.Thickness = 1
        hpBg.Filled = true
        hpBg.Color = Color3.fromRGB(0, 0, 0)
        hpBg.Visible = false
        storage.HpBg = hpBg

        -- HP Bar Fill
        local hpFill = Drawing.new("Square")
        hpFill.Thickness = 1
        hpFill.Filled = true
        hpFill.Color = ESP_State.HPColor
        hpFill.Visible = false
        storage.HpFill = hpFill

        -- Distance Text
        local distTxt = Drawing.new("Text")
        distTxt.Size = 13
        distTxt.Center = true
        distTxt.Outline = true
        distTxt.Color = ESP_State.DistanceColor
        distTxt.Visible = false
        storage.DistTxt = distTxt

        -- Skeleton Lines (16 Joint connections)
        storage.SkeletonLines = {}
        for i = 1, 16 do
            local line = Drawing.new("Line")
            line.Thickness = 1.5
            line.Color = ESP_State.SkeletonColor
            line.Visible = false
            table.insert(storage.SkeletonLines, line)
        end
    else
        -- Instance-based Billboard & Highlight Fallback
        local highlight = Instance.new("Highlight")
        highlight.Name = "KernelHighlight"
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = ESP_State.BoxColor
        highlight.FillColor = ESP_State.BoxColor
        highlight.Enabled = false
        storage.Highlight = highlight

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "KernelBillboard"
        billboard.Size = UDim2.new(0, 100, 0, 40)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = ESP_State.DistanceColor
        txt.Font = MainFont
        txt.TextSize = 12
        txt.TextStrokeTransparency = 0
        txt.Parent = billboard

        storage.Billboard = billboard
        storage.TextLabel = txt
    end

    ESP_Cache[player] = storage
end

-- Helper to find body part by multiple names (R15, R6, Project Delta Rigs)
local function FindPart(char, ...)
    for _, name in ipairs({...}) do
        local part = char:FindFirstChild(name)
        if part then return part end
    end
    return nil
end

-- Render Loop for Real-time ESP Updating (Protected with pcall to prevent ghost drawings)
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if IsUnloaded then return end
    Camera = workspace.CurrentCamera
    if not Camera then return end

    -- Active Cache Iteration with Auto-Cleanup for Despawned / Left Players
    for player, storage in pairs(ESP_Cache) do
        pcall(function()
            -- Verify Player & Character Existence
            if not player or not player.Parent or not player:IsDescendantOf(Players) then
                RemoveESP(player)
                return
            end

            local char = player.Character
            if not char or not char.Parent or not char:IsDescendantOf(workspace) then
                HideAllStorageDrawings(storage)
                return
            end

            local hrp = FindPart(char, "HumanoidRootPart", "Torso", "UpperTorso")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if not hrp or not hum or hum.Health <= 0 then
                HideAllStorageDrawings(storage)
                return
            end

            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            -- Ensure character is actually in front of the camera (Z > 0 and onScreen)
            if not onScreen or hrpPos.Z <= 0 then
                HideAllStorageDrawings(storage)
                return
            end

            local head = FindPart(char, "Head")
            local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.35, 0)) or Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3.5, 0))
            local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.2, 0))

            if headPos.Z <= 0 or legPos.Z <= 0 then
                HideAllStorageDrawings(storage)
                return
            end

            local height = math.abs(headPos.Y - legPos.Y)
            local width = height / 1.55

            if HasDrawing then
                -- Update 2D Box (White Fill + Black Background Outline)
                if ESP_State.Box and storage.Box and storage.BoxOutline then
                    storage.BoxOutline.Size = Vector2.new(width + 2, height + 2)
                    storage.BoxOutline.Position = Vector2.new(hrpPos.X - width/2 - 1, headPos.Y - 1)
                    storage.BoxOutline.Visible = true

                    storage.Box.Size = Vector2.new(width, height)
                    storage.Box.Position = Vector2.new(hrpPos.X - width/2, headPos.Y)
                    storage.Box.Color = ESP_State.BoxColor
                    storage.Box.Visible = true
                else
                    if storage.Box then storage.Box.Visible = false end
                    if storage.BoxOutline then storage.BoxOutline.Visible = false end
                end

                -- Update HP Bar
                if ESP_State.HP and storage.HpFill and storage.HpBg then
                    local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local hpHeight = height * hpPercent

                    storage.HpBg.Size = Vector2.new(3, height + 2)
                    storage.HpBg.Position = Vector2.new(hrpPos.X - width/2 - 6, headPos.Y - 1)
                    storage.HpBg.Visible = true

                    storage.HpFill.Size = Vector2.new(1, hpHeight)
                    storage.HpFill.Position = Vector2.new(hrpPos.X - width/2 - 5, headPos.Y + (height - hpHeight))
                    storage.HpFill.Color = Color3.fromRGB(255 * (1 - hpPercent), 255 * hpPercent, 50)
                    storage.HpFill.Visible = true
                else
                    if storage.HpBg then storage.HpBg.Visible = false end
                    if storage.HpFill then storage.HpFill.Visible = false end
                end

                -- Update Distance Text
                if ESP_State.Distance and storage.DistTxt and LocalPlayer.Character then
                    local myHRP = FindPart(LocalPlayer.Character, "HumanoidRootPart", "Torso")
                    if myHRP then
                        local dist = math.floor((myHRP.Position - hrp.Position).Magnitude)
                        storage.DistTxt.Text = string.format("%s [%dm]", player.Name, dist)
                        storage.DistTxt.Position = Vector2.new(hrpPos.X, headPos.Y + height + 4)
                        storage.DistTxt.Color = ESP_State.DistanceColor
                        storage.DistTxt.Visible = true
                    end
                else
                    if storage.DistTxt then storage.DistTxt.Visible = false end
                end

                -- Update Full Skeleton
                if ESP_State.Skeleton and storage.SkeletonLines then
                    local function DrawBoneLine(lineIndex, part1, part2)
                        local line = storage.SkeletonLines[lineIndex]
                        if line and part1 and part2 then
                            local v1, os1 = Camera:WorldToViewportPoint(part1.Position)
                            local v2, os2 = Camera:WorldToViewportPoint(part2.Position)
                            if os1 and os2 and v1.Z > 0 and v2.Z > 0 then
                                line.From = Vector2.new(v1.X, v1.Y)
                                line.To = Vector2.new(v2.X, v2.Y)
                                line.Color = ESP_State.SkeletonColor
                                line.Visible = true
                                return
                            end
                        end
                        if line then line.Visible = false end
                    end

                    local pHead = FindPart(char, "Head")
                    local pUpperTorso = FindPart(char, "UpperTorso", "Torso")
                    local pLowerTorso = FindPart(char, "LowerTorso", "HumanoidRootPart", "Torso")

                    local pLeftUpperArm = FindPart(char, "LeftUpperArm", "LeftArm", "Left Arm")
                    local pLeftLowerArm = FindPart(char, "LeftLowerArm", "LeftArm", "Left Arm")
                    local pLeftHand = FindPart(char, "LeftHand", "LeftLowerArm", "LeftArm")

                    local pRightUpperArm = FindPart(char, "RightUpperArm", "RightArm", "Right Arm")
                    local pRightLowerArm = FindPart(char, "RightLowerArm", "RightArm", "Right Arm")
                    local pRightHand = FindPart(char, "RightHand", "RightLowerArm", "RightArm")

                    local pLeftUpperLeg = FindPart(char, "LeftUpperLeg", "LeftLeg", "Left Leg")
                    local pLeftLowerLeg = FindPart(char, "LeftLowerLeg", "LeftLeg", "Left Leg")
                    local pLeftFoot = FindPart(char, "LeftFoot", "LeftLowerLeg", "LeftLeg")

                    local pRightUpperLeg = FindPart(char, "RightUpperLeg", "RightLeg", "Right Leg")
                    local pRightLowerLeg = FindPart(char, "RightLowerLeg", "RightLeg", "Right Leg")
                    local pRightFoot = FindPart(char, "RightFoot", "RightLowerLeg", "RightLeg")

                    DrawBoneLine(1, pHead, pUpperTorso)
                    DrawBoneLine(2, pUpperTorso, pLowerTorso)

                    DrawBoneLine(3, pUpperTorso, pLeftUpperArm)
                    DrawBoneLine(4, pLeftUpperArm, pLeftLowerArm)
                    DrawBoneLine(5, pLeftLowerArm, pLeftHand)

                    DrawBoneLine(6, pUpperTorso, pRightUpperArm)
                    DrawBoneLine(7, pRightUpperArm, pRightLowerArm)
                    DrawBoneLine(8, pRightLowerArm, pRightHand)

                    DrawBoneLine(9, pLowerTorso, pLeftUpperLeg)
                    DrawBoneLine(10, pLeftUpperLeg, pLeftLowerLeg)
                    DrawBoneLine(11, pLeftLowerLeg, pLeftFoot)

                    DrawBoneLine(12, pLowerTorso, pRightUpperLeg)
                    DrawBoneLine(13, pRightUpperLeg, pRightLowerLeg)
                    DrawBoneLine(14, pRightLowerLeg, pRightFoot)
                else
                    if storage.SkeletonLines then
                        for _, l in ipairs(storage.SkeletonLines) do l.Visible = false end
                    end
                end
            else
                -- Instance Fallback
                if storage.Highlight then
                    storage.Highlight.Parent = char
                    storage.Highlight.Enabled = ESP_State.Box
                    storage.Highlight.OutlineColor = ESP_State.BoxColor
                end
                if storage.Billboard then
                    storage.Billboard.Parent = char
                    if storage.TextLabel and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                        storage.TextLabel.Text = string.format("%s | HP: %d | [%dm]", player.Name, math.floor(hum.Health), dist)
                        storage.TextLabel.TextColor3 = ESP_State.DistanceColor
                    end
                end
            end
        end)
    end
end))

-- Track Active Players & Auto Refresh Every 3 Seconds
for _, player in ipairs(Players:GetPlayers()) do
    CreateESPForPlayer(player)
    table.insert(Connections, player.CharacterAdded:Connect(function()
        task.wait(0.5)
        CreateESPForPlayer(player)
    end))
end

table.insert(Connections, Players.PlayerAdded:Connect(function(player)
    CreateESPForPlayer(player)
    table.insert(Connections, player.CharacterAdded:Connect(function()
        task.wait(0.5)
        CreateESPForPlayer(player)
    end))
end))

table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
end))

-- Background Auto-Refresh Task (Runs every 3 seconds for new/respawned players)
task.spawn(function()
    while not IsUnloaded do
        task.wait(3)
        if IsUnloaded then break end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if not ESP_Cache[player] or not player.Character or not player.Character.Parent then
                    CreateESPForPlayer(player)
                end
            end
        end
    end
end)

