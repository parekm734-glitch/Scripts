    ClickBtn.BackgroundTransparency = 1
    ClickBtn.Text = ""
    ClickBtn.Parent = ToggleFrame

    local function UpdateToggle()
        if state then
            Tween(SwitchTrack, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Success, BorderColor3 = Theme.WhiteLine})
            Tween(SwitchKnob, TweenInfo.new(0.2), {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = Theme.Background})
        else
            Tween(SwitchTrack, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ToggleOff, BorderColor3 = Theme.Border})
            Tween(SwitchKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Theme.WhiteLineMuted})
        end
        callback(state)
    end

    ClickBtn.MouseButton1Click:Connect(function()
        state = not state
        UpdateToggle()
    end)

    ToggleFrame.MouseEnter:Connect(function()
        Tween(ToggleFrame, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover})
    end)
    ToggleFrame.MouseLeave:Connect(function()
        Tween(ToggleFrame, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card})
    end)
end

-- 4. Interactive Slider
function WorldGUI:CreateSlider(subTab, text, min, max, defaultVal, callback)
    callback = callback or function() end
    local value = math.clamp(defaultVal or min, min, max)

    local SliderFrame = Instance.new("Frame")
    SliderFrame.Name = "Slider_" .. text
    SliderFrame.Size = UDim2.new(1, 0, 0, 52)
    SliderFrame.BackgroundColor3 = Theme.Card
    SliderFrame.BorderColor3 = Theme.Border
    SliderFrame.BorderSizePixel = 1
    SliderFrame.Parent = subTab.PageFrame

    local SliderLabel = Instance.new("TextLabel")
    SliderLabel.Size = UDim2.new(0.7, 0, 0, 24)
    SliderLabel.Position = UDim2.new(0, 15, 0, 4)
    SliderLabel.BackgroundTransparency = 1
    SliderLabel.Text = text
    SliderLabel.Font = Enum.Font.GothamMedium
    SliderLabel.TextSize = 13
    SliderLabel.TextColor3 = Theme.TextMain
    SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
    SliderLabel.Parent = SliderFrame

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0.3, -15, 0, 24)
    ValueLabel.Position = UDim2.new(0.7, 0, 0, 4)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(value)
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextSize = 12
    ValueLabel.TextColor3 = Theme.WhiteLine
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Parent = SliderFrame

    local Track = Instance.new("Frame")
    Track.Name = "Track"
    Track.Size = UDim2.new(1, -30, 0, 8)
    Track.Position = UDim2.new(0, 15, 0, 32)
    Track.BackgroundColor3 = Theme.ToggleOff
    Track.BorderColor3 = Theme.Border
    Track.BorderSizePixel = 1
    Track.Parent = SliderFrame

    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Theme.WhiteLine
    Fill.BorderSizePixel = 0
    Fill.Parent = Track

    local Sliding = false

    local function SetValue(inputVal)
        local percentage = math.clamp((inputVal.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * percentage)
        ValueLabel.Text = tostring(value)
        Fill.Size = UDim2.new(percentage, 0, 1, 0)
        callback(value)
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Sliding = true
            SetValue(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Sliding = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            SetValue(input)
        end
    end)
end

