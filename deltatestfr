local function OpenColorPicker(initialColor, callback)
    local currH, currS, currV = initialColor:ToHSV()

    local pickerFrame = Instance.new("Frame")
    pickerFrame.Name = "ColorPickerRGBModal"
    pickerFrame.Size = UDim2.new(0, 200, 0, 190)
    pickerFrame.Position = UDim2.new(0.5, -100, 0.5, -95)
    pickerFrame.BackgroundColor3 = Colors.Background
    pickerFrame.BorderColor3 = Colors.AccentOrange
    pickerFrame.BorderSizePixel = 1
    pickerFrame.ZIndex = 200
    pickerFrame.Parent = MainFrame

    -- Header
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, 0, 0, 22)
    titleLbl.BackgroundColor3 = Colors.HeaderBg
    titleLbl.Text = "COLOR PALETTE"
    titleLbl.TextColor3 = Colors.TextWhite
    titleLbl.Font = MainFont
    titleLbl.TextSize = 11
    titleLbl.ZIndex = 201
    titleLbl.Parent = pickerFrame

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 20, 0, 20)
    closeBtn.Position = UDim2.new(1, -22, 0, 1)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Colors.TextDim
    closeBtn.Font = MainFont
    closeBtn.TextSize = 12
    closeBtn.ZIndex = 202
    closeBtn.Parent = titleLbl

    closeBtn.MouseButton1Click:Connect(function()
        pickerFrame:Destroy()
    end)

    -- 2D SV Canvas Box
    local svCanvas = Instance.new("Frame")
    svCanvas.Name = "SVCanvas"
    svCanvas.Size = UDim2.new(1, -20, 0, 120)
    svCanvas.Position = UDim2.new(0, 10, 0, 28)
    svCanvas.BackgroundColor3 = Color3.fromHSV(currH, 1, 1)
    svCanvas.BorderSizePixel = 1
    svCanvas.BorderColor3 = Colors.Border
    svCanvas.ZIndex = 201
    svCanvas.Parent = pickerFrame

    local satOverlay = Instance.new("Frame")
    satOverlay.Size = UDim2.new(1, 0, 1, 0)
    satOverlay.BackgroundTransparency = 0
    satOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    satOverlay.BorderSizePixel = 0
    satOverlay.ZIndex = 202
    satOverlay.Parent = svCanvas

    local satGrad = Instance.new("UIGradient")
    satGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    satGrad.Parent = satOverlay

    local valOverlay = Instance.new("Frame")
    valOverlay.Size = UDim2.new(1, 0, 1, 0)
    valOverlay.BackgroundTransparency = 0
    valOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    valOverlay.BorderSizePixel = 0
    valOverlay.ZIndex = 203
    valOverlay.Parent = svCanvas

    local valGrad = Instance.new("UIGradient")
    valGrad.Rotation = 90
    valGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0)
    })
    valGrad.Parent = valOverlay

    local cursor = Instance.new("Frame")
    cursor.Size = UDim2.new(0, 6, 0, 6)
    cursor.AnchorPoint = Vector2.new(0.5, 0.5)
    cursor.Position = UDim2.new(currS, 0, 1 - currV, 0)
    cursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    cursor.BorderColor3 = Color3.fromRGB(0, 0, 0)
    cursor.BorderSizePixel = 1
    cursor.ZIndex = 204
    cursor.Parent = svCanvas

    local hueBar = Instance.new("Frame")
    hueBar.Name = "HueBar"
    hueBar.Size = UDim2.new(1, -20, 0, 14)
    hueBar.Position = UDim2.new(0, 10, 0, 156)
    hueBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hueBar.BorderSizePixel = 1
    hueBar.BorderColor3 = Colors.Border
    hueBar.ZIndex = 201
    hueBar.Parent = pickerFrame

    local hueGrad = Instance.new("UIGradient")
    hueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
    })
    hueGrad.Parent = hueBar

    local hueCursor = Instance.new("Frame")
    hueCursor.Size = UDim2.new(0, 4, 1, 4)
    hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    hueCursor.Position = UDim2.new(currH, 0, 0.5, 0)
    hueCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hueCursor.BorderColor3 = Color3.fromRGB(0, 0, 0)
    hueCursor.BorderSizePixel = 1
    hueCursor.ZIndex = 204
    hueCursor.Parent = hueBar

    local function UpdateRGB()
        local newColor = Color3.fromHSV(currH, currS, currV)
        svCanvas.BackgroundColor3 = Color3.fromHSV(currH, 1, 1)
        cursor.Position = UDim2.new(currS, 0, 1 - currV, 0)
        hueCursor.Position = UDim2.new(currH, 0, 0.5, 0)
        callback(newColor)
    end

    local draggingSV = false
    local function InputSV(input)
        local posX = math.clamp((input.Position.X - svCanvas.AbsolutePosition.X) / svCanvas.AbsoluteSize.X, 0, 1)
        local posY = math.clamp((input.Position.Y - svCanvas.AbsolutePosition.Y) / svCanvas.AbsoluteSize.Y, 0, 1)
        currS = posX
        currV = 1 - posY
        UpdateRGB()
    end

    svCanvas.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            InputSV(input)
        end
    end)
    svCanvas.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
        end
    end)

    local draggingHue = false
    local function InputHue(input)
        local posX = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        currH = posX
        UpdateRGB()
    end

    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            InputHue(input)
        end
    end)
    hueBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = false
        end
    end)

    table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            if draggingSV then InputSV(input) end
            if draggingHue then InputHue(input) end
        end
    end))
end

-- Create Checkbox Row (Linked directly to ESP State + Real Color Updating)
local function AddToggleRow(parent, labelText, defaultChecked, colorSwatches, callback)
    local row = Instance.new("Frame")
    row.Name = "ToggleRow_" .. labelText
    row.Size = UDim2.new(1, 0, 0, 22)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local box = Instance.new("TextButton")
    box.Name = "Box"
    box.Size = UDim2.new(0, 14, 0, 14)
    box.Position = UDim2.new(0, 4, 0.5, -7)
    box.BackgroundColor3 = defaultChecked and Colors.AccentOrange or Colors.UncheckedBox
    box.BorderColor3 = defaultChecked and Colors.AccentOrange or Colors.UncheckedBorder
    box.BorderSizePixel = 1
    box.Text = ""
    box.Parent = row

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 26, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Colors.TextWhite
    label.Font = MainFont
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local checked = defaultChecked

    local function updateState()
        box.BackgroundColor3 = checked and Colors.AccentOrange or Colors.UncheckedBox
        box.BorderColor3 = checked and Colors.AccentOrange or Colors.UncheckedBorder
        if callback then callback(checked) end
    end

    box.MouseButton1Click:Connect(function()
        checked = not checked
        updateState()
    end)

    local labelBtn = Instance.new("TextButton")
    labelBtn.Size = label.Size
    labelBtn.Position = label.Position
    labelBtn.BackgroundTransparency = 1
    labelBtn.Text = ""
    labelBtn.Parent = row

    labelBtn.MouseButton1Click:Connect(function()
        checked = not checked
        updateState()
    end)

    -- Single Color Swatch with 2D HSV Palette
    if colorSwatches and #colorSwatches > 0 then
        local swatchHolder = Instance.new("Frame")
        swatchHolder.Name = "Swatches"
        swatchHolder.Size = UDim2.new(0, 22, 1, 0)
        swatchHolder.Position = UDim2.new(1, -24, 0, 0)
        swatchHolder.BackgroundTransparency = 1
        swatchHolder.Parent = row

        local initialColor = colorSwatches[1]
        local swatch = Instance.new("TextButton")
        swatch.Name = "Swatch_1"
        swatch.Size = UDim2.new(0, 18, 0, 10)
        swatch.Position = UDim2.new(0, 2, 0.5, -5)
        swatch.BackgroundColor3 = initialColor
        swatch.BorderColor3 = Colors.Border
        swatch.BorderSizePixel = 1
        swatch.Text = ""
        swatch.Parent = swatchHolder

        swatch.MouseButton1Click:Connect(function()
            OpenColorPicker(swatch.BackgroundColor3, function(newColor)
                swatch.BackgroundColor3 = newColor
                if labelText == "Show Enemy Box" then ESP_State.BoxColor = newColor end
                if labelText == "Show Enemy Skeleton" then ESP_State.SkeletonColor = newColor end
                if labelText == "Show Enemy HP" then ESP_State.HPColor = newColor end
                if labelText == "Show Enemy Distance" then ESP_State.DistanceColor = newColor end
            end)
        end)
    end

    return row
end

