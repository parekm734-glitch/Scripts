-- Detect and Destroy Any Pre-existing GUI Instances Before Execution
local function CleanupExistingGuis()
    local namesToDestroy = {
        "KernelCcGui",
        "VloneDevGui",
        "KernelMobileToggle",
        "VloneMobileToggle"
    }

    local targetParents = {}
    if gethui then 
        pcall(function() table.insert(targetParents, gethui()) end) 
    end
    pcall(function() table.insert(targetParents, CoreGui) end)
    pcall(function() 
        if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then 
            table.insert(targetParents, LocalPlayer.PlayerGui) 
        end 
    end)

    for _, parentObj in ipairs(targetParents) do
        if parentObj then
            for _, child in ipairs(parentObj:GetChildren()) do
                for _, targetName in ipairs(namesToDestroy) do
                    if child.Name == targetName then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end
    end
end

-- Run Cleanup Immediately
CleanupExistingGuis()

-- Safe Parent Getter for PC & Mobile Executors
local function GetGuiParent()
    local success, res = pcall(function()
        if gethui then
            return gethui()
        elseif syn and syn.protect_gui then
            local sg = Instance.new("ScreenGui")
            syn.protect_gui(sg)
            sg.Parent = CoreGui
            return sg
        elseif CoreGui then
            return CoreGui
        end
    end)
    if success and res then
        return res
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

